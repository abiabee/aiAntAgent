# Sage Intacct Web Services Credentials
# These are your Web Services sender credentials (not user login)
SAGE_SENDER_ID=your_sender_id
SAGE_SENDER_PASSWORD=your_sender_password

# Sage Intacct Company/User Credentials
SAGE_COMPANY_ID=your_company_id
SAGE_USER_ID=your_user_id
SAGE_USER_PASSWORD=your_user_password

# Optional: Entity/Location ID (for multi-entity companies)
SAGE_LOCATION_ID=

# Sage Intacct Dashboard URL (for Playwright verification)
SAGE_DASHBOARD_URL=https://www-p10794.intacct.com/ia/acct/frameset.phtml

# API Endpoint (typically don't change this)
SAGE_API_ENDPOINT=https://api.intacct.com/ia/xml/xmlgw.phtml
